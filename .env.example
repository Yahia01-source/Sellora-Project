NODE_ENV=development

# -- PostgreSQL Configuration --
POSTGRES_USER=sellora_user
POSTGRES_PASSWORD=sellora_secret_password
POSTGRES_DB=sellora_db
POSTGRES_PORT=5432

# Full connection string consumed by Prisma (apps/api)
DATABASE_URL="postgresql://sellora_user:sellora_secret_password@localhost:5432/sellora_db?schema=public"

# -- Redis Configuration --
REDIS_PASSWORD=sellora_redis_password
REDIS_PORT=6379
REDIS_URL="redis://:sellora_redis_password@localhost:6379"

# -- JWT Auth Configuration --
JWT_ACCESS_SECRET=CHANGE_ME_super_long_random_access_secret_for_sellora_commerce_os_saas
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_super_long_random_refresh_secret_for_sellora_commerce_os_saas
JWT_REFRESH_EXPIRES_IN=7d

# -- Ports & Prefixes --
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
WEB_PORT=3000

# -- Next.js Public Web URL --
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
